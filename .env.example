# NoTweet — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.

# Claude API key (from console.anthropic.com)
# This is only needed if you run a local proxy server (see /proxy folder).
# If you enter the key directly in the extension Settings, you don't need this.
CLAUDE_API_KEY=your_claude_api_key_here

# Proxy shared secret (must match what you set in extension Settings → Proxy Secret)
PROXY_SECRET=your_proxy_secret_here
